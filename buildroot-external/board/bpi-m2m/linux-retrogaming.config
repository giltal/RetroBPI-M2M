# RetroBPI_M2M kernel config fragment, applied on top of arch/arm/configs/sunxi_defconfig.
#
# sunxi_defconfig already provides: DRM=y, DRM_SUN4I=y, DRM_LIMA=y,
# BACKLIGHT_CLASS_DEVICE=y, BACKLIGHT_PWM=y, INPUT_EVDEV=y.
# Everything below is what it does *not* provide.

# --- MIPI DSI display path ---------------------------------------------
# The A33 DSI encoder. Absent from sunxi_defconfig, so nothing would bind
# to dsi@1ca0000 without this.
CONFIG_DRM_SUN6I_DSI=y
CONFIG_DRM_MIPI_DSI=y

# Our panels
CONFIG_DRM_PANEL_EK79007=y
CONFIG_DRM_PANEL_WAVESHARE_DSI_B=y

# The Waveshare (B)'s MCU at I2C 0x45 answers 0xc3 at REG_ID, i.e. the genuine
# RPi ATTINY register map (measured on hardware), so this stock driver owns its
# power, backlight and reset GPIOs unmodified.
CONFIG_REGULATOR_RASPBERRYPI_TOUCHSCREEN_ATTINY=y

# Backlight via the LED_CTRL flying wire on a plain GPIO.
CONFIG_BACKLIGHT_GPIO=y

# fbdev emulation + framebuffer console. On a board with no HDMI this is the
# cheapest possible "is the panel alive" signal: kernel boot messages appear
# on the LCD with zero userspace involved. Worth its weight during bring-up;
# revisit for the fast-boot pass.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# The panel is mounted upside down, so the boot console text was upside down for
# the few seconds before the launcher takes over. This option compiles fbcon's
# software rotation; the angle itself comes from fbcon=rotate:2 on the kernel
# command line (see boot/extlinux/extlinux.conf).
#
# Why the command line and not the panel's DT rotation property: our panel
# driver does not call of_drm_get_panel_orientation(), so the connector carries
# no orientation hint and drm_fb_helper computes ROTATE_0 regardless. Teaching
# the driver to expose it would work, but the DTS comment on that property is
# explicit that nothing consumes it automatically and each client compensates
# by itself -- RetroArch via video_rotation=2, the launcher via PANEL_ROTATION.
# Exposing the hint risks a consumer honouring it ON TOP of its own correction
# and ending up double-rotated. fbcon=rotate:2 touches the console only.
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y

# --- Touch --------------------------------------------------------------
# GT911 on the EK79007 panel. edt-ft5x06 is for the Waveshare 5" (B); note
# that panel has no INT line through the cable and needs the RPi polling
# patch backported before it will probe (see docs/cable_bringup_test.md).
CONFIG_TOUCHSCREEN_GOODIX=y
CONFIG_TOUCHSCREEN_EDT_FT5X06=y

# --- Input: USB gamepad -------------------------------------------------
# Mirrors the Lyra's rk3506-retrogaming.config. PS3 pad via hid-sony.
CONFIG_USB_HID=y
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_FF_MEMLESS=y

# --- Audio --------------------------------------------------------------
CONFIG_SND_USB_AUDIO=y

# --- USB gadget: ADB over the micro-USB OTG port ------------------------
# sunxi_defconfig already provides USB_MUSB_HDRC / USB_MUSB_SUNXI / USB_GADGET
# / PHY_SUN4I_USB, and the board DTS sets dr_mode = "otg" with ID detect on
# PH8. Only the configfs composition layer is missing; adbd uses functionfs.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- Wi-Fi: AP6212 (BCM43438) on SDIO (mmc1) ----------------------------
# sunxi_defconfig has "# CONFIG_WIRELESS is not set" and "# CONFIG_WLAN is not
# set", so the whole stack has to be turned on here. brcmfmac is FullMAC, so it
# needs cfg80211 but NOT mac80211 — which keeps this a lot smaller.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_BROADCOM=y
# brcmfmac MUST be a module, not built in. Built-in it probes at ~1.8 s, while
# the rootfs only mounts at ~3.9 s, so the firmware request fails with -2:
#   brcmfmac: Direct firmware load for brcm/brcmfmac43430-sdio.bin failed (-2)
# Observed on hardware; the file is present on the card. As a module it loads
# after userspace is up and /lib/firmware exists.
CONFIG_BRCMUTIL=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y

# --- Filesystems --------------------------------------------------------
# Read-only squashfs rootfs is the plan once the board boots (docs/strategy.md).
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_OVERLAY_FS=y

# --- USB ethernet -------------------------------------------------------
# A USB-Ethernet adapter on one of the host ports is the dev iteration link:
# real LAN, then ssh/scp from the workstation. ADB is not usable here --
# Buildroot ships android-tools 4.2.2 (2013) and a modern adb client wedges
# its connection on any service request beyond "devices" (auth is already
# disabled in that build, so auth is not the issue -- the protocol is).
#
# Built in rather than modules: unlike brcmfmac these need no firmware blob,
# so there is no rootfs-timing problem, and having the link up before
# userspace is one less thing to debug.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_RTL8152=y
CONFIG_USB_RTL8150=y
CONFIG_MII=y

# --- Bluetooth (AP6212 / BCM43430A1 on UART1) ---------------------------
# For a wireless DualShock 3. The DS3 is Bluetooth 2.0+EDR HID over L2CAP --
# NOT BLE -- so BR/EDR and HIDP are what matter here, not the LE stack.
#
# The board DTS already carries the node as a serdev child of uart1:
#   bluetooth { compatible = "brcm,bcm43438-bt"; shutdown-gpios = <&r_pio 0 8>; ... }
# so hci_bcm binds by itself; no hciattach/btattach is needed. Until CONFIG_BT
# existed the only sign of it was a stray dmesg line:
#   dw-apb-uart 1c28400.serial: Failed to create device link ... /soc/serial@1c28400/bluetooth
#
# BT_HCIUART is built in DELIBERATELY, which means the BCM43430A1 patchram is
# NOT loaded -- the serdev device binds at ~2.3 s, before the rootfs is mounted:
#   Bluetooth: hci0: BCM: firmware Patch file not found, tried:
#   Bluetooth: hci0: BCM: 'brcm/BCM43430A1.hcd'
#
# As a module (build #25) the patch DOES load, but the chip then stops
# responding and the post-patch reset times out, leaving hci0 half-registered:
#   Bluetooth: hci0: BCM43430A1 'brcm/BCM43430A1.hcd' Patch
#   Bluetooth: hci0: command 0x0c03 tx timeout
#   Bluetooth: hci0: BCM: Reset failed (-110)
# Reproducible on a clean module reload, so not a race. Suspects are the 32 kHz
# LPO clock not physically reaching the chip, or a post-patch baud quirk;
# neither confirmed. Flow control is correctly configured in the DTS
# (uart-has-rtscts + uart1_cts_rts_pg_pins), so that is not it.
#
# Built in, the chip runs on its ROM firmware and the adapter works -- but
# reports the unprogrammed address AA:AA:AA:AA:AA:AA, which is useless for
# pairing. We supply a real one via local-bd-address in the board DTS instead.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HIDP=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_CRYPTO_ECDH=y
CONFIG_CRYPTO_CMAC=y

# --- hidraw: required by BlueZ's sixaxis plugin --------------------------
# A DualShock 3 cannot be paired conventionally. BlueZ's sixaxis plugin writes
# the host's BD address into the pad over USB, and it does that through
# /dev/hidraw*. Without HIDRAW the plugin loads and then sits idle: the pad
# enumerates and works as a gamepad (HID_SONY gives js0/event3), but nothing can
# configure it, so it never pairs.
#
# HID_SONY/USB_HID alone are enough to USE a pad, not to SET UP one.
CONFIG_HIDRAW=y

# --- uhid: how BlueZ actually creates HID input devices ------------------
# BlueZ 5.x's input plugin creates HID devices over /dev/uhid, NOT via the
# legacy in-kernel HIDP interface. It is built with uhid support
# (HAVE_LINUX_UHID_H) and defaults to uhid_state = UHID_ENABLED.
#
# Without CONFIG_UHID a Bluetooth gamepad connects perfectly at the link level
# -- bluetoothctl shows "Connected: yes" -- and then no js0/event node ever
# appears, because nothing can instantiate the HID device. BT_HIDP alone is not
# enough; it covers a path BlueZ no longer takes.
CONFIG_UHID=y

# --- Audio: the missing card driver -------------------------------------
# The board DTS already enables &codec, &dai and &sound, and SND_SUN8I_CODEC /
# SND_SUN8I_CODEC_ANALOG / SND_SUN4I_I2S are all built. What was missing is the
# driver for the card itself: the sound node is
#     compatible = "simple-audio-card";  name = "sun8i-a33-audio"
# and without SND_SIMPLE_CARD nothing binds it, so sound/soc/generic is never
# built and the kernel reports "ALSA device list: No soundcards found" with no
# probe attempt logged at all.
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_SIMPLE_CARD_UTILS=y

# For a future speaker-amp enable GPIO (the SN2010BIF09E on the breakout has
# SDB/PA-SHDN pulled low, so the amp is off until something drives it high).
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=y

# --- Mesa/lima: GPU acceleration ----------------------------------------
# DRM_LIMA is already on; the userspace half was missing entirely, so every
# frame was scaled and blitted on the CPU into a DRM dumb buffer.
CONFIG_DRM_LIMA=y

# --- uinput: synthetic input for automated on-target testing -------------
# Lets a host-side script inject real key/button events through the very same
# evdev/udev path a physical gamepad uses, so the launcher and RetroArch can
# be driven without a human pressing buttons. This is how the menu-flicker
# measurement opens the menu while a game is running. Costs ~6 KB.
CONFIG_INPUT_UINPUT=y
