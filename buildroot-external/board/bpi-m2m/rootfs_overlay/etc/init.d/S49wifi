#!/bin/sh
#
# Wi-Fi (AP6212 / BCM43438 on SDIO) + DHCP.
#
# Does nothing unless /etc/wpa_supplicant.conf has a real network block, so an
# unconfigured board boots at full speed instead of blocking on association.
# Configure with:
#   wpa_passphrase "MySSID" "mypassphrase" >> /etc/wpa_supplicant.conf
#
CONF=/etc/wpa_supplicant.conf
IFACE=wlan0

start() {
	grep -q '^[[:space:]]*ssid=' "$CONF" 2>/dev/null || {
		echo "Wi-Fi: no network configured in $CONF, skipping"
		exit 0
	}

	printf "Starting Wi-Fi: "
	# brcmfmac probes off the SDIO bus; give it a moment to create wlan0
	i=0
	while [ ! -d /sys/class/net/$IFACE ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ ! -d /sys/class/net/$IFACE ]; then
		echo "FAIL (no $IFACE - check brcmfmac firmware in /lib/firmware/brcm)"
		exit 1
	fi

	ip link set $IFACE up
	wpa_supplicant -B -i $IFACE -c "$CONF" -D nl80211 || {
		echo "FAIL (wpa_supplicant)"
		exit 1
	}
	udhcpc -b -i $IFACE -x hostname:"$(hostname)" >/dev/null 2>&1 &
	echo "OK"
}

stop() {
	printf "Stopping Wi-Fi: "
	killall udhcpc 2>/dev/null
	killall wpa_supplicant 2>/dev/null
	ip link set $IFACE down 2>/dev/null
	echo "OK"
}

case "$1" in
	start)   start ;;
	stop)    stop ;;
	restart|reload) stop; start ;;
	*)       echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
